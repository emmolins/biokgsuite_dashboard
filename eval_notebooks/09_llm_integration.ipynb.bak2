   "source": [
    "## 12 · Full statistical analysis\n",
    "\n",
    "Publication-style summary. The resampling unit is the **disease** (shuffles and\n",
    "seeds of the same disease are correlated), so all 95% CIs come from a\n",
    "**cluster bootstrap over diseases**. The KG lift is tested **paired by disease**\n",
    "(ΔMRR = KG − no-KG) with a bootstrap CI and a paired permutation p-value, so the\n",
    "test respects that each disease is seen under both conditions.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "9243ccd4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== Per-condition metrics (95% CI = cluster bootstrap over diseases) ===\n",
      "condition  n_obs  n_dis   MRR       MRR_95CI  Hits@1    Hits@1_95CI  Hits@3    Hits@3_95CI  Hits@5    Hits@5_95CI  reliance  conf  parse_rate\n",
      "       kg   1320     22 0.439 [0.372, 0.507]   0.241 [0.166, 0.320]   0.502 [0.401, 0.595]   0.693 [0.595, 0.773]     0.568  2.25       0.995\n",
      "    no_kg    330     22 0.318 [0.277, 0.365]   0.109 [0.070, 0.155]   0.358 [0.282, 0.436]   0.570 [0.497, 0.645]     0.639  3.07       0.994\n",
      "\n",
      "(random-ranking chance MRR for pool=8: 0.340)\n",
      "\n",
      "=== KG lift (paired by disease) ===\n",
      "ΔMRR (KG − no-KG) = +0.121   95% CI [+0.053, +0.187]   paired-permutation p = 0.0024\n",
      "KG helped in 68% of 22 diseases  (hurt 32%, tied 0%)\n",
      "\n",
      "=== KG lift by therapeutic area ===\n",
      "                mean_lift  n_diseases\n",
      "area                                 \n",
      "Cardiovascular      0.173           2\n",
      "Dermatology         0.146           1\n",
      "Immunology          0.133           6\n",
      "Oncology            0.116          12\n",
      "Respiratory        -0.025           1\n",
      "  → Saved: 09_full_analysis.pdf / .png\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 2250x540 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ===================== 12 · Full statistical analysis =====================\n",
    "import numpy as np, pandas as pd, matplotlib.pyplot as plt\n",
    "\n",
    "A = res.copy()\n",
    "# attach therapeutic area (join from the gold standard)\n",
    "try:\n",
    "    _area = (load_positives(GOLD_FILE).drop_duplicates('disease_name')\n",
    "             .set_index('disease_name')['therapeutic_area'])\n",
    "    A['area'] = A['disease'].map(_area).fillna('unknown')\n",
    "except Exception:\n",
    "    A['area'] = 'unknown'\n",
    "\n",
    "CHANCE = sum(1.0 / k for k in range(1, POOL_SIZE + 1)) / POOL_SIZE\n",
    "NBOOT = 5000\n",
    "_rng = np.random.default_rng(12)\n",
    "\n",
    "def _cluster_boot(df, col, B=NBOOT):\n",
    "    \"\"\"95% CI for the mean of `col`, resampling whole diseases (clusters).\"\"\"\n",
    "    clusters = [g[col].to_numpy() for _, g in df.groupby('disease')]\n",
    "    k = len(clusters)\n",
    "    means = np.empty(B)\n",
    "    for b in range(B):\n",
    "        idx = _rng.integers(0, k, k)\n",
    "        means[b] = np.concatenate([clusters[i] for i in idx]).mean()\n",
    "    return float(np.percentile(means, 2.5)), float(np.percentile(means, 97.5))\n",
    "\n",
    "# ---- 1. metrics table per condition, with cluster-bootstrap CIs ----\n",
    "METRICS = [('reciprocal_rank', 'MRR'), ('hit@1', 'Hits@1'), ('hit@3', 'Hits@3'), ('hit@5', 'Hits@5')]\n",
    "rows = []\n",
    "ci_store = {}\n",
    "for cond, d in A.groupby('condition'):\n",
    "    rec = {'condition': cond, 'n_obs': len(d), 'n_dis': d['disease'].nunique()}\n",
    "    for col, lab in METRICS:\n",
    "        pt = d[col].mean(); lo, hi = _cluster_boot(d, col)\n",
    "        rec[lab] = round(pt, 3); rec[f'{lab}_95CI'] = f'[{lo:.3f}, {hi:.3f}]'\n",
    "        ci_store[(cond, lab)] = (pt, lo, hi)\n",
    "    rec['reliance'] = round(d['frac_basis_kg'].dropna().mean(), 3) if d['frac_basis_kg'].notna().any() else np.nan\n",
    "    rec['conf'] = round(d['mean_confidence'].dropna().mean(), 2) if d['mean_confidence'].notna().any() else np.nan\n",
    "    rec['parse_rate'] = round(d['parsed'].mean(), 3)\n",
    "    rows.append(rec)\n",
    "metrics = pd.DataFrame(rows)\n",
    "print('=== Per-condition metrics (95% CI = cluster bootstrap over diseases) ===')\n",
    "print(metrics.to_string(index=False))\n",
    "print(f'\\n(random-ranking chance MRR for pool={POOL_SIZE}: {CHANCE:.3f})')\n",
    "\n",
    "# ---- 2. KG lift, paired by disease ----\n",
    "if {'no_kg', 'kg'}.issubset(set(A['condition'])):\n",
    "    piv = A.groupby(['disease', 'condition'])['reciprocal_rank'].mean().unstack('condition').dropna(subset=['no_kg', 'kg'])\n",
    "    delta = (piv['kg'] - piv['no_kg']).to_numpy()\n",
    "    obs = delta.mean()\n",
    "    bd = np.array([_rng.choice(delta, len(delta), replace=True).mean() for _ in range(NBOOT)])\n",
    "    dlo, dhi = np.percentile(bd, [2.5, 97.5])\n",
    "    signs = _rng.choice([-1, 1], size=(20000, len(delta)))\n",
    "    null = (signs * np.abs(delta)).mean(axis=1)\n",
    "    pval = (np.sum(np.abs(null) >= abs(obs)) + 1) / (20000 + 1)\n",
    "    print('\\n=== KG lift (paired by disease) ===')\n",
    "    print(f'ΔMRR (KG − no-KG) = {obs:+.3f}   95% CI [{dlo:+.3f}, {dhi:+.3f}]   paired-permutation p = {pval:.4f}')\n",
    "    print(f'KG helped in {(delta > 0).mean()*100:.0f}% of {len(delta)} diseases  '\n",
    "          f'(hurt {(delta < 0).mean()*100:.0f}%, tied {(delta == 0).mean()*100:.0f}%)')\n",
    "\n",
    "    # ---- 3. lift by therapeutic area ----\n",
    "    pa = (A.groupby(['area', 'disease', 'condition'])['reciprocal_rank'].mean()\n",
    "            .unstack('condition').dropna(subset=['no_kg', 'kg']))\n",
    "    pa['delta'] = pa['kg'] - pa['no_kg']\n",
    "    print('\\n=== KG lift by therapeutic area ===')\n",
    "    print(pa.groupby('area')['delta'].agg(mean_lift='mean', n_diseases='count').round(3).to_string())\n",
    "\n",
    "# ---- 4. figures ----\n",
    "fig, ax = plt.subplots(1, 4, figsize=(15, 3.6))\n",
    "order = [c for c in ['no_kg', 'kg'] if c in set(A['condition'])]\n",
    "colors = {'no_kg': '5F7079', 'kg': '12B38C'}\n",
    "cmap = {c: '#' + colors[c] for c in order}\n",
    "\n",
    "# (a) MRR ± 95% CI\n",
    "pts = [ci_store[(c, 'MRR')][0] for c in order]\n",
    "err = [[ci_store[(c, 'MRR')][0] - ci_store[(c, 'MRR')][1] for c in order],\n",
    "       [ci_store[(c, 'MRR')][2] - ci_store[(c, 'MRR')][0] for c in order]]\n",
    "ax[0].bar(order, pts, yerr=err, capsize=5, color=[cmap[c] for c in order])\n",
    "ax[0].axhline(CHANCE, ls=':', c='gray', lw=1); ax[0].text(0, CHANCE + .01, 'chance', color='gray', fontsize=8)\n",
    "ax[0].set_title('MRR ± 95% CI'); ax[0].set_ylim(0, max(pts) * 1.3)\n",
    "\n",
    "# (b) Hits@k grouped, with CI\n",
    "ks = ['Hits@1', 'Hits@3', 'Hits@5']; x = np.arange(len(ks)); w = 0.38\n",
    "for j, c in enumerate(order):\n",
    "    vals = [ci_store[(c, k)][0] for k in ks]\n",
    "    e = [[ci_store[(c, k)][0] - ci_store[(c, k)][1] for k in ks],\n",
    "         [ci_store[(c, k)][2] - ci_store[(c, k)][0] for k in ks]]\n",
    "    ax[1].bar(x + j * w, vals, w, yerr=e, capsize=3, label=c, color=cmap[c])\n",
    "ax[1].set_xticks(x + w / 2); ax[1].set_xticklabels(ks); ax[1].set_title('Hits@k ± 95% CI'); ax[1].legend(fontsize=8)\n",
    "\n",
    "# (c) per-disease ΔMRR waterfall\n",
    "if {'no_kg', 'kg'}.issubset(set(A['condition'])):\n",
    "    ds = np.sort(delta)\n",
    "    ax[2].bar(range(len(ds)), ds, color=['#12B38C' if v > 0 else '#C0584A' for v in ds])\n",
    "    ax[2].axhline(0, c='k', lw=0.8); ax[2].set_title('Per-disease ΔMRR (KG − no-KG)')\n",
    "    ax[2].set_xlabel('disease (sorted)')\n",
    "\n",
    "# (d) rank distribution\n",
    "for c in order:\n",
    "    rk = A[A['condition'] == c]['rank']\n",
    "    ax[3].hist(rk, bins=np.arange(1, POOL_SIZE + 2) - 0.5, alpha=0.6, label=c, color=cmap[c], density=True)\n",
    "ax[3].set_title('Rank distribution'); ax[3].set_xlabel('rank of true drug'); ax[3].legend(fontsize=8)\n",
    "\n",
    "plt.tight_layout(); save_fig(fig, FIGS, '09_full_analysis'); plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3fee8119",
   "metadata": {},
   "source": [
    "## 13 · Multi-KG: common evaluable set + paired comparison\n",
    "\n",
    "For a fair KG-*quality* comparison, every KG must be scored on the **same** diseases — otherwise\n",
    "coverage confounds quality. This section derives each KG's resolvable-disease set (drug **and** disease\n",
    "node present), takes the **intersection** across all KGs in the results, and runs the paired comparison on\n",
    "that common set: per-KG MRR with cluster-bootstrap CIs, a Friedman omnibus (do the KGs differ at all?),\n",
    "and Holm-corrected pairwise paired tests. Coverage (resolvable / 22) is reported separately — it is its\n",
    "own axis of KG quality, not folded into the MRR comparison.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "941634a3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "coverage (resolvable diseases per KG): {'primekg': 31, 'drkg': 27, 'biokg': 26, 'openbilink': 9}\n",
      "COMMON evaluable set: 7 diseases resolvable in ALL of ['primekg', 'drkg', 'biokg', 'openbilink']\n",
      "\n",
      "paired matrix: 6 diseases x 4 KGs\n",
      "\n",
      "per-KG MRR on the COMMON set:\n",
      "         kg   MRR             CI coverage\n",
      "      biokg 0.678 [0.482, 0.825]    26/34\n",
      "       drkg 0.465 [0.358, 0.572]    27/34\n",
      " openbilink 0.424 [0.297, 0.573]     9/34\n",
      "    primekg 0.663 [0.455, 0.811]    31/34\n",
      "(no-KG ref) 0.293 [0.260, 0.328]        -\n",
      "\n",
      "Friedman omnibus (do the KGs differ?): chi2 = 4.00 (df=3), permutation p = 0.2797\n",
      "\n",
      "pairwise KG vs KG (paired over the common diseases, Holm-corrected):\n",
      "                pair   dMRR              CI  p_raw  p_holm\n",
      "openbilink - primekg -0.239 [-0.456, 0.020] 0.1261  0.7566\n",
      "  biokg - openbilink  0.254 [-0.015, 0.505] 0.1582  0.7910\n",
      "      drkg - primekg -0.198 [-0.372, 0.043] 0.1598  0.7910\n",
      "        biokg - drkg  0.212 [-0.033, 0.439] 0.1906  0.7910\n",
      "   drkg - openbilink  0.041 [-0.102, 0.221] 0.7484  1.0000\n",
      "     biokg - primekg  0.015 [-0.073, 0.127] 0.8767  1.0000\n"
     ]
    }
   ],
   "source": [
    "# ============ 13 · Multi-KG: common evaluable set + paired comparison ============\n",
    "import numpy as np, pandas as pd\n",
    "\n",
    "KGS_IN_RES = [k for k in res['kg'].unique() if k != 'none']\n",
    "if len(KGS_IN_RES) < 2:\n",
    "    print(f'Only KG(s) {KGS_IN_RES} in results — run the multi-KG sweep (set KGS to several graphs, '\n",
    "          'FORCE_RERUN=True) before this comparison.')\n",
    "else:\n",
    "    # 1. resolvable-disease set per KG (node-presence inclusion criterion)\n",
    "    def _resolvable(kg):\n",
    "        c = _load_kg_core(kg)                       # reuses the run's cached load\n",
    "        id2i, to_d, to_x = c['id_to_idx'], c['to_drug_ids'], c['to_disease_ids']\n",
    "        dt, xt = c['drug_t'], c['disease_t']\n",
    "        def hit(cands, want):\n",
    "            return any(t == want for cc in cands for _, t in id2i.get(cc, []))\n",
    "        return {r.disease_name for r in pos_df.itertuples()\n",
    "                if hit(to_d(r.drug_id), dt) and hit(to_x(r.disease_id), xt)}\n",
    "\n",
    "    resolv = {kg: _resolvable(kg) for kg in KGS_IN_RES}\n",
    "    print('coverage (resolvable diseases per KG):', {k: len(v) for k, v in resolv.items()})\n",
    "    COMMON = set.intersection(*resolv.values())\n",
    "    print(f'COMMON evaluable set: {len(COMMON)} diseases resolvable in ALL of {KGS_IN_RES}\\n')\n",
    "\n",
    "    # 2. per-disease x KG mean MRR on the common set (KG arm)\n",
    "    sub = res[(res.condition == 'kg') & (res.disease.isin(COMMON))]\n",
    "    M = sub.groupby(['disease', 'kg'])['reciprocal_rank'].mean().unstack('kg').dropna()\n",
    "    print(f'paired matrix: {M.shape[0]} diseases x {M.shape[1]} KGs')\n",
    "\n",
    "    rng = np.random.default_rng(13); B = 5000\n",
    "    def _boot_ci(vals):\n",
    "        v = np.asarray(vals, float); n = len(v)\n",
    "        bs = np.array([v[rng.integers(0, n, n)].mean() for _ in range(B)])\n",
    "        return float(np.percentile(bs, 2.5)), float(np.percentile(bs, 97.5))\n",
    "\n",
    "    # 3. per-KG MRR on common set, cluster-bootstrap CI over diseases (+ no-KG reference)\n",
    "    rows = []\n",
    "    for kg in M.columns:\n",
    "        lo, hi = _boot_ci(M[kg].values)\n",
    "        rows.append(dict(kg=kg, MRR=round(M[kg].mean(), 3), CI=f'[{lo:.3f}, {hi:.3f}]',\n",
    "                         coverage=f'{len(resolv[kg])}/{len(pos_df.disease_name.unique())}'))\n",
    "    nb_ref = res[(res.condition == 'no_kg') & (res.disease.isin(COMMON))]\n",
    "    if len(nb_ref):\n",
    "        nbm = nb_ref.groupby('disease')['reciprocal_rank'].mean().reindex(M.index).dropna()\n",
    "        lo, hi = _boot_ci(nbm.values)\n",
    "        rows.append(dict(kg='(no-KG ref)', MRR=round(nbm.mean(), 3), CI=f'[{lo:.3f}, {hi:.3f}]', coverage='-'))\n",
    "    print('\\nper-KG MRR on the COMMON set:')\n",
    "    print(pd.DataFrame(rows).to_string(index=False))\n",
    "\n",
    "    # 4. Friedman omnibus — do the KGs differ at all? (repeated measures over diseases,\n",
    "    #    rank within each disease; permutation p-value so no scipy dependency)\n",
    "    R = M.rank(axis=1).values\n",
    "    n_d, k = R.shape\n",
    "    def _friedman_chi2(Rm):\n",
    "        Rj = Rm.sum(axis=0)\n",
    "        return 12.0 / (n_d * k * (k + 1)) * np.sum(Rj ** 2) - 3 * n_d * (k + 1)\n",
    "    chi2 = _friedman_chi2(R)\n",
    "    rngF = np.random.default_rng(99)\n",
    "    null = np.array([_friedman_chi2(np.apply_along_axis(rngF.permutation, 1, R)) for _ in range(5000)])\n",
    "    p_fried = (np.sum(null >= chi2) + 1) / 5001\n",
    "    print(f'\\nFriedman omnibus (do the KGs differ?): chi2 = {chi2:.2f} (df={k-1}), permutation p = {p_fried:.4f}')\n",
    "\n",
    "    # 5. pairwise paired comparison, Holm-corrected\n",
    "    cols = list(M.columns)\n",
    "    pairs = [(a, b) for i, a in enumerate(cols) for b in cols[i + 1:]]\n",
    "    pr = []\n",
    "    for a, b in pairs:\n",
    "        d = (M[a] - M[b]).values; obs = d.mean()\n",
    "        bs = np.array([d[rng.integers(0, len(d), len(d))].mean() for _ in range(B)])\n",
    "        lo, hi = np.percentile(bs, [2.5, 97.5])\n",
    "        signs = rng.choice([-1, 1], size=(20000, len(d)))\n",
    "        null = (signs * np.abs(d)).mean(axis=1)\n",
    "        pval = (np.sum(np.abs(null) >= abs(obs)) + 1) / 20001\n",
    "        pr.append(dict(pair=f'{a} - {b}', dMRR=round(obs, 3), CI=f'[{lo:.3f}, {hi:.3f}]', p_raw=pval))\n",
    "    pr = pd.DataFrame(pr)\n",
    "    # Holm step-down\n",
    "    m = len(pr); praw = pr['p_raw'].values\n",
    "    order = np.argsort(praw); holm = np.empty(m); run = 0.0\n",
    "    for rank, idx in enumerate(order):\n",
    "        run = max(run, praw[idx] * (m - rank)); holm[idx] = min(run, 1.0)\n",
    "    pr['p_holm'] = holm.round(4)\n",
    "    print('\\npairwise KG vs KG (paired over the common diseases, Holm-corrected):')\n",
    "    print(pr.sort_values('p_raw').round(4).to_string(index=False))\n"
   ]
  }
 ],
