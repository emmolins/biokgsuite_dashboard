    "# ── Single-call trial — run BEFORE the full sweep ───────────────────────────\n",
    "assert not MOCK, \"Set MODE = 'real' in the config cell to actually call the API.\"\n",
    "TRIAL_MODEL = MODELS[0]\n",
    "assert is_api_model(TRIAL_MODEL), f\"{TRIAL_MODEL!r} is not a hosted-API model.\"\n",
    "assert _api_key_for(TRIAL_MODEL), (\n",
    "    f\"Missing key: set {API_PROVIDERS[_provider_model(TRIAL_MODEL)[0]]['key']} in your env.\")\n",
    "\n",
    "# Build the KG evidence functions for the first KG (loads the graph once).\n",
    "_block_for, _disease_profile_fn = make_kg_block_fn(\n",
    "    KGS[0], bridge_mode=BRIDGE_MODE, cap=CAP,\n",
    "    anonymize=ANONYMIZE, anonymize_genes=ANONYMIZE_GENES)\n",
    "\n",
    "q = QUERIES[0]\n",
    "ids = sorted({c['drug_id'] for c in q['candidates']})\n",
    "code_map = {did: f'Drug-{i + 1}' for i, did in enumerate(ids)} if ANONYMIZE else None\n",
    "\n",
    "rng = np.random.default_rng(SEED)\n",
    "view, pos_letter = assign_letters_and_evidence(\n",
    "    q['candidates'], _block_for, q['disease_id'], 'kg', MOCK, rng, code_map=code_map)\n",
    "dprof  = _disease_profile_fn(q['disease_id'], q['disease_name'])\n",
    "prompt = build_prompt(q['disease_name'], q['disease_id'], view, disease_profile=dprof)\n",
    "\n",
    "print('=' * 72); print('PROMPT'); print('=' * 72)\n",
    "print(prompt)\n",
    "\n",
    "resp = rank_call(TRIAL_MODEL, prompt, view, 0)\n",
    "print('\\n' + '=' * 72); print(f'RAW RESPONSE   (model = {TRIAL_MODEL})'); print('=' * 72)\n",
    "print(resp)\n",
    "\n",
    "ordered, _ = parse_response(resp, [c['letter'] for c in view])\n",
    "print('\\nparsed order   :', ordered)\n",
    "print('true drug      :', pos_letter, '-> rank', rank_of(pos_letter, ordered, POOL_SIZE))\n"
   ]
