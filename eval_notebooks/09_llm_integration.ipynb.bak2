   ],
   "source": [
    "# Per-seed MRR BY KG (each KG vs the shared no-KG baseline), then across-seed mean ± SD.\n",
    "if 'seed' in res.columns and res['seed'].nunique() > 1:\n",
    "    for model in sorted(res['model'].unique()):\n",
    "        rm = res[res['model'] == model]\n",
    "        # shared no-KG baseline: one MRR per seed\n",
    "        base = rm[rm.condition == 'no_kg'].groupby('seed')['reciprocal_rank'].mean().rename('no_kg')\n",
    "        # each KG arm: MRR per (kg, seed) -> seed rows, one column per KG\n",
    "        perkg = (rm[rm.condition == 'kg'].groupby(['kg', 'seed'])['reciprocal_rank']\n",
    "                   .mean().unstack('kg'))\n",
    "        if perkg.empty:\n",
    "            continue\n",
    "        lift = perkg.sub(base, axis=0)          # KG - no_kg, matched by seed\n",
    "\n",
    "        print(f'\\n================ {model} ================')\n",
    "        print('per-seed MRR  (rows = seed, cols = each KG + no-KG):')\n",
    "        print(perkg.join(base).round(3).to_string())\n",
    "        print('\\nper-seed KG lift  (KG MRR - no-KG MRR, same seed):')\n",
    "        print(lift.round(3).to_string())\n",
    "\n",
    "        summ = pd.DataFrame({\n",
    "            'MRR_mean':  perkg.mean(),  'MRR_sd':  perkg.std(),\n",
    "            'lift_mean': lift.mean(),   'lift_sd': lift.std(),\n",
    "            'n_seeds':   perkg.count(),\n",
    "        }).round(3).sort_values('MRR_mean', ascending=False)\n",
    "        print('\\nacross-seed summary BY KG (seeds as replicates, ranked by MRR):')\n",
    "        print(summ.to_string())\n",
    "        print(f'\\nno-KG baseline: MRR {base.mean():.3f} +/- {base.std():.3f}  '\n",
    "              f'(chance ~= {sum(1/k for k in range(1, POOL_SIZE + 1)) / POOL_SIZE:.3f})')\n",
    "else:\n",
    "    print('Single seed in results - set SEEDS to >1 value and rerun (FORCE_RERUN=True).')"
   ]
  },
  {
